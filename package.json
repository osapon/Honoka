{
  "name": "honoka-bootstrap5",
  "version": "5.3.3-0.1.0",
  "private": true,
  "description": "Honoka's Japanese typography tuning ported onto Bootstrap 5",
  "license": "MIT",
  "scripts": {
    "build": "sass --load-path=node_modules --no-source-map scss/bootstrap-honoka.scss dist/css/bootstrap.css",
    "build:min": "sass --load-path=node_modules --no-source-map --style=compressed scss/bootstrap-honoka.scss dist/css/bootstrap.min.css",
    "watch": "sass --load-path=node_modules --watch scss/bootstrap-honoka.scss dist/css/bootstrap.css"
  },
  "devDependencies": {
    "bootstrap": "5.3.3",
    "sass": "1.77.8"
  }
}
